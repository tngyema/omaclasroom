#!/usr/bin/env python3
"""One-command setup for Omaclasroom. Handles Google Cloud project creation,
OAuth credential setup, and token storage."""

import http.server
import json
import os
import subprocess
import sys
import webbrowser
from urllib.parse import urlencode, urlparse, parse_qs
from urllib.request import Request, build_opener


GOOGLE_AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
REDIRECT_PORT = 8099
REDIRECT_URI = f"http://localhost:{REDIRECT_PORT}"
SCOPES = [
    "https://www.googleapis.com/auth/classroom.courses.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.me.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.students.readonly",
    "https://www.googleapis.com/auth/classroom.rosters.readonly",
]


def step1_authenticate_gcloud():
    """Step 1: Authenticate gcloud CLI."""
    print("\n=== Step 1: Sign in to Google Cloud ===")
    print("A browser window will open. Sign in with your school email.\n")
    subprocess.run(["gcloud", "auth", "login"], check=True)
    print("Signed in successfully!\n")


def step2_create_project(project_id):
    """Step 2: Create Google Cloud project."""
    print(f"\n=== Step 2: Creating project '{project_id}' ===")
    result = subprocess.run(
        ["gcloud", "projects", "create", project_id, "--name=omaclasroom"],
        capture_output=True, text=True,
    )
    if result.returncode != 0 and "already exists" not in result.stderr.lower():
        print(f"Warning: {result.stderr.strip()}")
    subprocess.run(
        ["gcloud", "config", "set", "project", project_id],
        check=True, capture_output=True,
    )
    print(f"Project '{project_id}' ready!\n")


def step3_enable_api():
    """Step 3: Enable Classroom API."""
    print("\n=== Step 3: Enabling Google Classroom API ===")
    subprocess.run(
        ["gcloud", "services", "enable", "classroom.googleapis.com"],
        check=True, capture_output=True,
    )
    print("Google Classroom API enabled!\n")


def step4_create_oauth_credentials():
    """Step 4: Create OAuth2 credentials via OAuth Consent Screen + Credentials."""
    print("\n=== Step 4: Creating OAuth2 credentials ===")

    # Configure consent screen
    print("Configuring consent screen...")
    subprocess.run([
        "gcloud", "iap", "web", "oauth-clients", "create",
        "--display_name=omaclasroom",
    ], capture_output=True, text=True)

    # Try to create OAuth client via gcloud
    result = subprocess.run([
        "gcloud", "iap", "web", "oauth-clients", "list",
        "--format=json",
    ], capture_output=True, text=True)

    if result.returncode == 0 and result.stdout.strip():
        clients = json.loads(result.stdout)
        if clients:
            client = clients[0]
            print(f"Found existing OAuth client: {client.get('name', 'unknown')}")
            return client

    # If that didn't work, use the projects API approach
    print("Creating new OAuth client ID...")
    result = subprocess.run([
        "gcloud", "services", "enable", "oauth2.googleapis.com",
    ], capture_output=True, text=True)

    print("\nManual step needed: Creating OAuth credentials requires browser access.")
    print("Please run these steps manually:")
    print("  1. Go to https://console.cloud.google.com/apis/credentials")
    print("  2. Click '+ Create Credentials → OAuth client ID'")
    print("  3. Application type: Desktop app")
    print("  4. Name: omaclasroom")
    print("  5. Copy the Client ID and Client Secret\n")

    return None


def run_oauth_flow(client_id, client_secret):
    """Step 5: Run OAuth2 flow and save token."""
    print("\n=== Step 5: Authorization ===")

    scope = " ".join(SCOPES)
    auth_params = urlencode({
        "client_id": client_id,
        "redirect_uri": REDIRECT_URI,
        "response_type": "code",
        "scope": scope,
        "access_type": "offline",
        "prompt": "consent",
    })
    auth_url = f"{GOOGLE_AUTH_URL}?{auth_params}"

    print(f"Opening browser for Google authorization...")
    print(f"If the browser doesn't open, visit:\n{auth_url}\n")
    webbrowser.open(auth_url)

    auth_code = None

    class AuthHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            nonlocal auth_code
            params = parse_qs(urlparse(self.path).query)
            if "code" in params:
                auth_code = params["code"][0]
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(b"<h1>Success! You can close this tab.</h1>")
            else:
                error = params.get("error", ["unknown"])[0]
                self.send_response(400)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(f"<h1>Failed: {error}</h1>".encode())
        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("localhost", REDIRECT_PORT), AuthHandler)
    server.timeout = 120
    server.handle_request()

    if not auth_code:
        print("Authorization failed or timed out.")
        return False

    print("Exchanging authorization code for tokens...")
    token_data = urlencode({
        "code": auth_code,
        "client_id": client_id,
        "client_secret": client_secret,
        "redirect_uri": REDIRECT_URI,
        "grant_type": "authorization_code",
    }).encode("utf-8")

    request = Request(GOOGLE_TOKEN_URL, data=token_data, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")

    try:
        with build_opener().open(request, timeout=30) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except Exception as e:
        print(f"Token exchange failed: {e}")
        return False

    if "refresh_token" not in payload:
        print(f"Token exchange failed: {payload.get('error', 'no refresh token')}")
        return False

    # Save to keyring
    for key, value in [("client_id", client_id), ("client_secret", client_secret),
                        ("refresh_token", payload["refresh_token"])]:
        subprocess.run(
            ["secret-tool", "store", "--label", f"Omaclasroom {key}",
             "service", "omaclasroom", "key", key],
            input=value + "\n", text=True, check=True,
        )

    print("Credentials saved to system keyring!")
    return True


def main():
    print("=" * 50)
    print("  Omaclasroom — Quick Setup")
    print("=" * 50)

    # Check if already set up
    result = subprocess.run(
        ["secret-tool", "lookup", "service", "omaclasroom", "key", "refresh_token"],
        capture_output=True, text=True,
    )
    if result.stdout.strip():
        print("\nOmaclasroom is already configured!")
        print("To reconfigure, run: omaclasroom clear-token")
        return

    project_id = "polished-watch-462805-e6"

    step1_authenticate_gcloud()
    step2_create_project(project_id)
    step3_enable_api()

    client = step4_create_oauth_credentials()

    if not client:
        print("\nWaiting for you to create OAuth credentials...")
        print("Paste your Client ID and Client Secret below.\n")
        client_id = input("Client ID: ").strip()
        client_secret = input("Client Secret: ").strip()
    else:
        # Extract from gcloud response
        client_id = client.get("clientId", "")
        client_secret = client.get("secret", "")
        if not client_id or not client_secret:
            print("\nCouldn't extract credentials from gcloud response.")
            client_id = input("Client ID: ").strip()
            client_secret = input("Client Secret: ").strip()

    if run_oauth_flow(client_id, client_secret):
        print("\n" + "=" * 50)
        print("  Setup complete! Right-click the Omaclasroom")
        print("  bar icon to refresh and see your courses.")
        print("=" * 50)
    else:
        print("\nSetup failed. Try running: omaclasroom set-token")


if __name__ == "__main__":
    main()
