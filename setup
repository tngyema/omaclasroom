#!/usr/bin/env python3
"""Omaclasroom setup — simple OAuth flow. No gcloud required."""

import http.server
import json
import os
import subprocess
import sys
import webbrowser
from urllib.parse import urlencode, urlparse, parse_qs
from urllib.request import Request, build_opener

GOOGLE_AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
REDIRECT_PORT = 8099
REDIRECT_URI = f"http://localhost:{REDIRECT_PORT}"
SCOPES = [
    "https://www.googleapis.com/auth/classroom.courses.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.me.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.students.readonly",
    "https://www.googleapis.com/auth/classroom.rosters.readonly",
]

CONFIG_DIR = os.path.expanduser("~/.config/omarchy/plugins/io.github.omaclasroom")
CREDENTIALS_FILE = os.path.join(CONFIG_DIR, "credentials.json")


def check_existing():
    """Check if already set up."""
    if os.path.exists(CREDENTIALS_FILE):
        try:
            with open(CREDENTIALS_FILE) as f:
                data = json.load(f)
            if data.get("refresh_token"):
                print("\nOmaclasroom is already configured!")
                print("To reconfigure, run: omaclasroom-setup --clear")
                return True
        except (json.JSONDecodeError, KeyError):
            pass
    return False


def get_credentials():
    """Get or create OAuth credentials."""
    if os.path.exists(CREDENTIALS_FILE):
        with open(CREDENTIALS_FILE) as f:
            data = json.load(f)
        if data.get("client_id") and data.get("client_secret"):
            return data["client_id"], data["client_secret"]

    print("\nYou need a Google Cloud project with Classroom API enabled.")
    print("If you don't have one, create it at: https://console.cloud.google.com")
    print("Then enable the Classroom API.\n")

    print("Enter your OAuth2 credentials:")
    print("(Create at: https://console.cloud.google.com/apis/credentials)")
    print("  Application type: Desktop app\n")

    client_id = input("Client ID: ").strip()
    client_secret = input("Client Secret: ").strip()

    if not client_id or not client_secret:
        print("Error: Client ID and Client Secret are required.")
        sys.exit(1)

    return client_id, client_secret


def run_oauth_flow(client_id, client_secret):
    """Run OAuth2 authorization flow."""
    scope = " ".join(SCOPES)
    auth_params = urlencode({
        "client_id": client_id,
        "redirect_uri": REDIRECT_URI,
        "response_type": "code",
        "scope": scope,
        "access_type": "offline",
        "prompt": "consent",
    })
    auth_url = f"{GOOGLE_AUTH_URL}?{auth_params}"

    print(f"\nOpening browser for Google authorization...")
    print(f"If the browser doesn't open, visit:\n{auth_url}\n")
    webbrowser.open(auth_url)

    auth_code = None

    class AuthHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            nonlocal auth_code
            params = parse_qs(urlparse(self.path).query)
            if "code" in params:
                auth_code = params["code"][0]
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(b"<h1>Success! You can close this tab.</h1>")
            else:
                error = params.get("error", ["unknown"])[0]
                self.send_response(400)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(f"<h1>Failed: {error}</h1>".encode())
        def log_message(self, *args):
            pass

    server = http.server.HTTPServer(("localhost", REDIRECT_PORT), AuthHandler)
    server.timeout = 120
    server.handle_request()

    if not auth_code:
        print("Authorization failed or timed out.")
        return False

    print("Exchanging authorization code for tokens...")
    token_data = urlencode({
        "code": auth_code,
        "client_id": client_id,
        "client_secret": client_secret,
        "redirect_uri": REDIRECT_URI,
        "grant_type": "authorization_code",
    }).encode("utf-8")

    request = Request(GOOGLE_TOKEN_URL, data=token_data, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")

    try:
        with build_opener().open(request, timeout=30) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except Exception as e:
        print(f"Token exchange failed: {e}")
        return False

    if "refresh_token" not in payload:
        print(f"Token exchange failed: {payload.get('error', 'no refresh token')}")
        return False

    # Save credentials
    os.makedirs(CONFIG_DIR, exist_ok=True)
    credentials = {
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": payload["refresh_token"],
    }
    with open(CREDENTIALS_FILE, "w") as f:
        json.dump(credentials, f, indent=2)
    os.chmod(CREDENTIALS_FILE, 0o600)

    print("Credentials saved!")
    return True


def clear_credentials():
    """Remove stored credentials."""
    if os.path.exists(CREDENTIALS_FILE):
        os.remove(CREDENTIALS_FILE)
        print("Credentials cleared.")
    else:
        print("No credentials found.")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--clear":
        clear_credentials()
        return

    if len(sys.argv) > 1 and sys.argv[1] == "--status":
        if os.path.exists(CREDENTIALS_FILE):
            print("Configured")
        else:
            print("Not configured")
        return

    print("=" * 50)
    print("  Omaclasroom Setup")
    print("=" * 50)

    if check_existing():
        return

    client_id, client_secret = get_credentials()

    if run_oauth_flow(client_id, client_secret):
        print("\n" + "=" * 50)
        print("  Setup complete!")
        print("  Right-click the Omaclasroom bar icon to refresh.")
        print("=" * 50)
    else:
        print("\nSetup failed. Try running: omaclasroom-setup")


if __name__ == "__main__":
    main()
