#!/usr/bin/env python3
"""Omaclasroom data helper for the native Omarchy bar plugin.

Fetches Google Classroom courses and upcoming assignments for students
and teachers using the Google Classroom REST API with OAuth2 credentials.
"""
from __future__ import annotations

import argparse
import http.server
