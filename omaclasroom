from urllib.parse import urlencode, urlparse, parse_qs
from urllib.request import HTTPRedirectHandler, Request, build_opener


SERVICE = "omaclasroom"
PAYLOAD_VERSION = 1
VISIBILITY_VERSION = 1
MAX_RESPONSE_BYTES = 8 * 1024 * 1024
MAX_PAGES = 50
MAX_RECORDS = 10_000
MAX_FETCH_SECONDS = 120
REQUEST_TIMEOUT_SECONDS = 20

GOOGLE_AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
GOOGLE_CLASSROOM_SCOPES = [
    "https://www.googleapis.com/auth/classroom.courses.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.me",
    "https://www.googleapis.com/auth/classroom.coursework.me.readonly",
    "https://www.googleapis.com/auth/classroom.coursework.students.readonly",
    "https://www.googleapis.com/auth/classroom.rosters.readonly",
]
CLASSROOM_BASE = "https://classroom.googleapis.com"


class ClassroomAuthenticationError(RuntimeError):
    """Raised when Google rejects the OAuth2 credentials."""


class ClassroomPermissionError(RuntimeError):
    """Raised when a valid token cannot access a Classroom resource."""


def _keyring_available() -> bool:
    return shutil.which("secret-tool") is not None


def _keyring_lookup(key: str) -> str | None:
    secret_tool = shutil.which("secret-tool")
    if not secret_tool:
        return None
    try:
        result = subprocess.run(
            [secret_tool, "lookup", "service", SERVICE, "key", key],
            check=False, capture_output=True, text=True, timeout=5,
        )
        value = result.stdout.strip()
        return value or None
    except (OSError, subprocess.SubprocessError):
        return None


def _keyring_store(key: str, value: str, label: str = "") -> None:
    secret_tool = shutil.which("secret-tool")
    if not secret_tool:
        raise RuntimeError("secret-tool is required to store credentials; install libsecret")
    try:
        subprocess.run(
            [secret_tool, "store", f"--label={label or key}",
             "service", SERVICE, "key", key],
            input=value + "\n", text=True, check=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not save credential: {error}") from error


def _keyring_clear(key: str) -> None:
    secret_tool = shutil.which("secret-tool")
    if not secret_tool:
        raise RuntimeError("secret-tool is required to remove saved credentials")
    try:
        subprocess.run(
            [secret_tool, "clear", "service", SERVICE, "key", key],
            check=True, capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not remove credential: {error}") from error


def get_credentials() -> dict[str, str] | None:
    """Retrieve stored OAuth2 credentials from the system keyring."""
    client_id = _keyring_lookup("client_id")
    client_secret = _keyring_lookup("client_secret")
    refresh_token = _keyring_lookup("refresh_token")
    if client_id and client_secret and refresh_token:
        return {
            "client_id": client_id,
            "client_secret": client_secret,
            "refresh_token": refresh_token,
        }
    return None


def save_credentials(client_id: str, client_secret: str, refresh_token: str) -> None:
    """Store OAuth2 credentials in the system keyring."""
    _keyring_store("client_id", client_id, "Omaclasroom Client ID")
    _keyring_store("client_secret", client_secret, "Omaclasroom Client Secret")
    _keyring_store("refresh_token", refresh_token, "Omaclasroom Refresh Token")


def clear_credentials() -> None:
    """Remove stored OAuth2 credentials from the system keyring."""
    for key in ("client_id", "client_secret", "refresh_token"):
        _keyring_clear(key)


def refresh_access_token(client_id: str, client_secret: str, refresh_token: str) -> str:
    """Exchange a refresh token for a new access token."""
    data = urlencode({
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }).encode("utf-8")
    request = Request(GOOGLE_TOKEN_URL, data=data, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with build_opener().open(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            payload = json.loads(response.read(MAX_RESPONSE_BYTES).decode("utf-8"))
            if "access_token" not in payload:
                msg = payload.get("error_description", payload.get("error", "unknown error"))
                raise ClassroomAuthenticationError(f"Token refresh failed: {msg}")
            return payload["access_token"]
    except HTTPError as error:
        body = error.read(MAX_RESPONSE_BYTES).decode("utf-8", errors="replace")
        try:
            payload = json.loads(body)
            msg = payload.get("error_description", payload.get("error", str(error)))
        except (json.JSONDecodeError, ValueError):
            msg = str(error)
        raise ClassroomAuthenticationError(f"Token refresh failed: {msg}") from error
    except (URLError, TimeoutError) as error:
        raise ClassroomAuthenticationError(f"Could not reach Google: {error}") from error


def sanitize_text(value: Any, fallback: str = "") -> str:
    text = unescape(str(value if value is not None else fallback))
    text = "".join(
        " " if unicodedata.category(c) in {"Cc", "Cf"} else c
        for c in text
    )
    return " ".join(text.split()) or fallback


def visibility_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "omaclasroom" / "hidden-courses.json"


def _load_visibility(path: Path | None = None) -> dict[str, Any]:
    path = path or visibility_path()
    if path.is_symlink():
        raise RuntimeError("Hidden-course preferences must not be a symbolic link")
    if not path.exists():
        return {"version": VISIBILITY_VERSION, "instances": {"default": {}}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Could not read hidden-course preferences: {error}") from error
    if not isinstance(data, dict) or data.get("version") != VISIBILITY_VERSION:
        raise RuntimeError("Hidden-course preferences use an unsupported format")
    if "instances" not in data or not isinstance(data["instances"], dict):
        data["instances"] = {"default": {}}
    return data


def hidden_courses_for(path: Path | None = None) -> dict[str, dict[str, str]]:
    data = _load_visibility(path)
    return data["instances"].get("default", {})


def set_course_hidden(
    course_id: str,
    hidden: bool,
    name: str = "",
    section: str = "",
    path: Path | None = None,
) -> None:
    path = path or visibility_path()
    data = _load_visibility(path)
    courses = data["instances"].setdefault("default", {})
    course_key = str(course_id)
    if hidden:
        courses[course_key] = {"name": name, "section": section}
    else:
        courses.pop(course_key, None)
        if not courses:
            data["instances"].pop("default", None)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    serialized = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(serialized)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


class ClassroomClient:
    """Minimal Google Classroom REST API client using only the standard library."""

    def __init__(self, access_token: str, opener=None, clock=None):
        self.access_token = access_token
        self.opener = opener or build_opener()
        self.clock = clock or time.monotonic
        self.deadline = self.clock() + MAX_FETCH_SECONDS

    def _request_timeout(self) -> float:
        remaining = self.deadline - self.clock()
        if remaining <= 0:
            raise RuntimeError("Classroom refresh exceeded the allowed duration")
        return min(REQUEST_TIMEOUT_SECONDS, remaining)

    def _get(self, url: str, params: dict[str, Any] | None = None) -> Any:
        if params:
            url += "?" + urlencode(params, doseq=True)
        request = Request(url)
        request.add_header("Authorization", f"Bearer {self.access_token}")
        request.add_header("Accept", "application/json")
        try:
            with self.opener.open(request, timeout=self._request_timeout()) as response:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                if len(raw) > MAX_RESPONSE_BYTES:
                    raise RuntimeError("Classroom API response exceeded the size limit")
                return json.loads(raw.decode("utf-8"))
        except HTTPError as error:
            if error.code == 401:
                raise ClassroomAuthenticationError(
                    "Google rejected the access token"
                ) from error
            if error.code == 403:
                raise ClassroomPermissionError(
                    "Google denied access to Classroom data"
                ) from error
            raise RuntimeError(f"Classroom API returned HTTP {error.code}") from error
        except (URLError, TimeoutError, UnicodeDecodeError, json.JSONDecodeError) as error:
            raise RuntimeError(f"Could not reach Google Classroom: {error}") from error

    def _post(self, url: str, body: dict[str, Any] | None = None) -> Any:
        data = json.dumps(body or {}).encode("utf-8")
        request = Request(url, data=data, method="POST")
        request.add_header("Authorization", f"Bearer {self.access_token}")
        request.add_header("Content-Type", "application/json")
        request.add_header("Accept", "application/json")
        try:
            with self.opener.open(request, timeout=self._request_timeout()) as response:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                return json.loads(raw.decode("utf-8")) if raw else {}
        except HTTPError as error:
            body_text = error.read(MAX_RESPONSE_BYTES).decode("utf-8", errors="replace")
            if error.code == 401:
                raise ClassroomAuthenticationError(
                    "Google rejected the access token"
                ) from error
            if error.code == 403:
                raise ClassroomPermissionError(
                    "Google denied access to Classroom data"
                ) from error
            try:
                err = json.loads(body_text)
                msg = err.get("error", {}).get("message", str(error))
            except (json.JSONDecodeError, ValueError):
                msg = str(error)
            raise RuntimeError(f"Classroom API returned HTTP {error.code}: {msg}") from error
        except (URLError, TimeoutError) as error:
            raise RuntimeError(f"Could not reach Google Classroom: {error}") from error

    def _patch(self, url: str, body: dict[str, Any] | None = None) -> Any:
        data = json.dumps(body or {}).encode("utf-8")
        request = Request(url, data=data, method="PATCH")
        request.add_header("Authorization", f"Bearer {self.access_token}")
        request.add_header("Content-Type", "application/json")
        request.add_header("Accept", "application/json")
        try:
            with self.opener.open(request, timeout=self._request_timeout()) as response:
                raw = response.read(MAX_RESPONSE_BYTES + 1)
                return json.loads(raw.decode("utf-8")) if raw else {}
        except HTTPError as error:
            body_text = error.read(MAX_RESPONSE_BYTES).decode("utf-8", errors="replace")
            if error.code == 401:
                raise ClassroomAuthenticationError(
                    "Google rejected the access token"
                ) from error
            if error.code == 403:
                raise ClassroomPermissionError(
                    "Google denied access to Classroom data"
                ) from error
            try:
                err = json.loads(body_text)
                msg = err.get("error", {}).get("message", str(error))
            except (json.JSONDecodeError, ValueError):
                msg = str(error)
            raise RuntimeError(f"Classroom API returned HTTP {error.code}: {msg}") from error
        except (URLError, TimeoutError) as error:
            raise RuntimeError(f"Could not reach Google Classroom: {error}") from error

    def get_my_user_id(self) -> str:
        """Get the authenticated user's Google Classroom user ID."""
        data = self._get(f"{CLASSROOM_BASE}/v1/userProfiles/me")
        return str(data.get("id", ""))

    def list_courses(self) -> list[dict[str, Any]]:
        """List active courses for the authenticated user."""
        courses: list[dict[str, Any]] = []
        page_token = None
        while True:
            if len(courses) >= MAX_RECORDS:
                raise RuntimeError("Classroom API response exceeded the record limit")
            params: dict[str, Any] = {
                "courseStates": ["ACTIVE"],
                "pageSize": 50,
            }
            if page_token:
                params["pageToken"] = page_token
            data = self._get(f"{CLASSROOM_BASE}/v1/courses", params)
            for course in data.get("courses", []):
                courses.append(course)
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return courses

    def list_teachers(self, course_id: str) -> list[dict[str, Any]]:
        """List teachers for a course. Used to determine if the user is a teacher."""
        teachers: list[dict[str, Any]] = []
        page_token = None
        while True:
            params: dict[str, Any] = {"pageSize": 50}
            if page_token:
                params["pageToken"] = page_token
            data = self._get(
                f"{CLASSROOM_BASE}/v1/courses/{course_id}/teachers", params,
            )
            for teacher in data.get("teachers", []):
                profile = teacher.get("profile", {})
                teachers.append({
                    "userId": profile.get("id", ""),
                    "emailAddress": profile.get("emailAddress", ""),
                })
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return teachers

    def list_course_work(self, course_id: str) -> list[dict[str, Any]]:
        """List coursework (assignments) for a course."""
        work_items: list[dict[str, Any]] = []
        page_token = None
        while True:
            if len(work_items) >= MAX_RECORDS:
                raise RuntimeError("Classroom API response exceeded the record limit")
            params: dict[str, Any] = {"pageSize": 50}
            if page_token:
                params["pageToken"] = page_token
            data = self._get(
                f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork", params,
            )
            for item in data.get("courseWork", []):
                work_items.append(item)
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return work_items

    def list_submitted_students(self, course_id: str, course_work_id: str) -> list[str]:
        """List student submission IDs for a piece of coursework."""
        submissions: list[str] = []
        page_token = None
        while True:
            params: dict[str, Any] = {"pageSize": 50}
            if page_token:
                params["pageToken"] = page_token
            data = self._get(
                f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
                f"/{course_work_id}/studentSubmissions",
                params,
            )
            for sub in data.get("studentSubmissions", []):
                state = sub.get("state", "")
                if state in ("TURNED_IN", "RETURNED"):
                    submissions.append(sub.get("id", ""))
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return submissions

    def list_student_submissions(self, course_id: str) -> dict[str, bool]:
        """For student view: list which coursework the current user has submitted."""
        submitted: dict[str, bool] = {}
        page_token = None
        while True:
            params: dict[str, Any] = {"pageSize": 50}
            if page_token:
                params["pageToken"] = page_token
            data = self._get(
                f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
                f"/-",
                params,
            )
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return submitted

    def list_my_submissions(self, course_id: str) -> dict[str, str]:
        """List the current user's submission states for a course.

        Returns a mapping of courseWorkId -> state (e.g. TURNED_IN, CREATED).
        """
        states: dict[str, str] = {}
        page_token = None
        while True:
            params: dict[str, Any] = {"userId": "me", "pageSize": 100}
            if page_token:
                params["pageToken"] = page_token
            data = self._get(
                f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
                f"/-/studentSubmissions",
                params,
            )
            for sub in data.get("studentSubmissions", []):
                work_id = sub.get("courseWorkId", "")
                state = sub.get("state", "UNKNOWN")
                if work_id:
                    states[work_id] = state
            page_token = data.get("nextPageToken")
            if not page_token:
                break
        return states

    def get_or_create_submission(
        self, course_id: str, course_work_id: str,
    ) -> dict[str, Any]:
        """Get or create a student submission for an assignment."""
        data = self._get(
            f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
            f"/{course_work_id}/studentSubmissions",
            {"userId": "me"},
        )
        submissions = data.get("studentSubmissions", [])
        if submissions:
            return submissions[0]
        return self._post(
            f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
            f"/{course_work_id}/studentSubmissions",
            {"userId": "me"},
        )

    def add_link_attachment(
        self, course_id: str, course_work_id: str,
        submission_id: str, link_url: str, title: str = "",
    ) -> dict[str, Any]:
        """Add a link attachment to a student submission."""
        return self._post(
            f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
            f"/{course_work_id}/studentSubmissions/{submission_id}:modifyAttachments",
            {
                "addAttachments": [{
                    "link": {
                        "url": link_url,
                    },
                }],
            },
        )

    def add_drive_attachment(
        self, course_id: str, course_work_id: str,
        submission_id: str, drive_file_id: str, title: str = "",
    ) -> dict[str, Any]:
        """Add a Google Drive file attachment to a student submission."""
        return self._post(
            f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
            f"/{course_work_id}/studentSubmissions/{submission_id}:modifyAttachments",
            {
                "addAttachments": [{
                    "driveFile": {
                        "id": drive_file_id,
                        "title": title,
                    },
                }],
            },
        )

    def turn_in(
        self, course_id: str, course_work_id: str, submission_id: str,
    ) -> dict[str, Any]:
        """Turn in a student submission."""
        return self._post(
            f"{CLASSROOM_BASE}/v1/courses/{course_id}/courseWork"
            f"/{course_work_id}/studentSubmissions/{submission_id}:turnIn",
        )

    def submit_assignment(
        self, course_id: str, course_work_id: str,
        link_url: str = "", drive_file_id: str = "",
        title: str = "",
    ) -> dict[str, Any]:
        """Full submit flow: get/create submission, add attachment, turn in."""
        submission = self.get_or_create_submission(course_id, course_work_id)
        sub_id = submission.get("id", "")
        if not sub_id:
            raise RuntimeError("Could not create or find submission")
        if link_url:
            self.add_link_attachment(
                course_id, course_work_id, sub_id, link_url, title,
            )
        elif drive_file_id:
            self.add_drive_attachment(
                course_id, course_work_id, sub_id, drive_file_id, title,
            )
        return self.turn_in(course_id, course_work_id, sub_id)


def parse_time(value: Any) -> datetime | None:
    if isinstance(value, dict):
        year = value.get("year")
        month = value.get("month", 1)
        day = value.get("day", 1)
        hour = value.get("hour", 0)
        minute = value.get("minute", 0)
        if year and month and day:
            try:
                return datetime(int(year), int(month), int(day),
                                int(hour), int(minute), tzinfo=timezone.utc)
            except (TypeError, ValueError):
                return None
        return None
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)
    except (TypeError, ValueError):
        return None


def iso_time(value: Any) -> str | None:
    parsed = parse_time(value)
    return parsed.isoformat() if parsed is not None else None


def sanitize_classroom_link(value: Any) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    if any(unicodedata.category(c) == "Cc" for c in value):
        return None
    candidate = value.strip()
    if not candidate.startswith("https://classroom.google.com"):
        return None
    return candidate


def collect_student(
    client: ClassroomClient,
    courses: list[dict[str, Any]],
    days: int,
    now: datetime,
    hidden_ids: set[str],
) -> dict[str, Any]:
    """Collect data for the student role."""
    result_courses = []
    hidden_courses = []
    for course in courses:
        course_id = str(course.get("id", ""))
        course_name = sanitize_text(course.get("name"), "Unnamed course")
        course_section = sanitize_text(course.get("section"))
        if course_id in hidden_ids:
            hidden_courses.append({
                "id": course_id, "name": course_name,
                "section": course_section,
            })
            continue
        work_items = client.list_course_work(course_id)
        submission_states = client.list_my_submissions(course_id)
        upcoming = []
        for work in work_items:
            due_date = work.get("dueDate")
            due_time = work.get("dueTime")
            due = parse_time(due_date)
            if due and due_time:
                h = due_time.get("hours", due_time.get("hour", 0))
                m = due_time.get("minutes", due_time.get("minute", 0))
                due = due.replace(hour=int(h or 0), minute=int(m or 0))
            work_id = work.get("id", "")
            state = submission_states.get(work_id, "UNKNOWN")
            is_submitted = state in ("TURNED_IN", "RETURNED")
            if due is None:
                continue
            cutoff = now + timedelta(days=days)
            is_missing = due < now and not is_submitted
            is_in_range = now <= due <= cutoff
            if not is_missing and not is_in_range and not is_submitted:
                continue
            upcoming.append({
                "id": work_id,
                "name": sanitize_text(work.get("title"), "Untitled"),
                "due_at": due.isoformat(),
                "submitted": is_submitted,
                "state": state,
                "published": True,
                "locked": False,
                "missing": is_missing,
                "alternateLink": sanitize_classroom_link(work.get("alternateLink")) or "",
                "courseworkType": sanitize_text(work.get("workType")),
            })
        upcoming.sort(key=lambda item: item["due_at"])
        result_courses.append({
            "id": course_id,
            "name": course_name,
            "section": course_section,
            "alternateLink": sanitize_classroom_link(course.get("alternateLink")) or "",
            "courseState": sanitize_text(course.get("courseState")),
            "current_score": None,
            "current_grade": None,
            "assignments": upcoming,
        })
    result_courses.sort(key=lambda item: item["name"].lower())
    hidden_courses.sort(key=lambda item: item["name"].lower())
    return {
        "available": bool(result_courses or hidden_courses),
        "error": "",
        "courses": result_courses,
        "hidden_courses": hidden_courses,
    }


def collect_teacher(
    client: ClassroomClient,
    courses: list[dict[str, Any]],
    days: int,
    now: datetime,
    hidden_ids: set[str],
) -> dict[str, Any]:
    """Collect data for the teacher role."""
    result_courses = []
    hidden_courses = []
    for course in courses:
        course_id = str(course.get("id", ""))
        course_name = sanitize_text(course.get("name"), "Unnamed course")
        course_section = sanitize_text(course.get("section"))
        if course_id in hidden_ids:
            hidden_courses.append({
                "id": course_id, "name": course_name,
                "section": course_section,
            })
            continue
        work_items = client.list_course_work(course_id)
        upcoming = []
        for work in work_items:
            due = parse_time(work.get("dueDate"))
            if due is None:
                continue
            cutoff = now + timedelta(days=days)
            if not now <= due <= cutoff:
                continue
            published = work.get("published", True)
            upcoming.append({
                "id": work.get("id"),
                "name": sanitize_text(work.get("title"), "Untitled"),
                "due_at": due.isoformat(),
                "submitted": False,
                "published": published,
                "locked": False,
                "alternateLink": sanitize_classroom_link(work.get("alternateLink")) or "",
                "courseworkType": sanitize_text(work.get("workType")),
            })
        upcoming.sort(key=lambda item: item["due_at"])
        result_courses.append({
            "id": course_id,
            "name": course_name,
            "section": course_section,
            "alternateLink": sanitize_classroom_link(course.get("alternateLink")) or "",
            "courseState": sanitize_text(course.get("courseState")),
            "current_score": None,
            "current_grade": None,
            "assignments": upcoming,
        })
    result_courses.sort(key=lambda item: item["name"].lower())
    hidden_courses.sort(key=lambda item: item["name"].lower())
    return {
        "available": bool(result_courses or hidden_courses),
        "error": "",
        "courses": result_courses,
        "hidden_courses": hidden_courses,
    }


def collect(
    client: ClassroomClient,
    days: int = 14,
    now: datetime | None = None,
    hidden_course_ids: set[str] | None = None,
    all_courses: list[dict[str, Any]] | None = None,
    my_user_id: str = "",
) -> dict[str, Any]:
    """Fetch courses and assignments for both student and teacher roles.

    Google Classroom does not separate courses by enrollment type like Canvas.
    Instead, we determine the user's role by checking if they are listed as a
    teacher for each course. The ``all_courses`` parameter allows tests to
    inject pre-fetched courses without calling the API. The ``my_user_id``
    parameter identifies the authenticated user; when empty, ``list_teachers``
    is used to discover the user ID.
    """
    now = now or datetime.now(timezone.utc)
    hidden_course_ids = hidden_course_ids or set()
    if all_courses is None:
        all_courses = client.list_courses()
    if not my_user_id:
        try:
            my_user_id = client.get_my_user_id()
        except (ClassroomPermissionError, ClassroomAuthenticationError, RuntimeError):
            my_user_id = ""
    teacher_course_ids: set[str] = set()
    for course in all_courses:
        course_id = str(course.get("id", ""))
        try:
            teachers = client.list_teachers(course_id)
            for teacher in teachers:
                if teacher.get("userId") == my_user_id:
                    teacher_course_ids.add(course_id)
                    break
        except ClassroomPermissionError:
            pass
    student_courses = [
        c for c in all_courses if str(c.get("id", "")) not in teacher_course_ids
    ]
    teacher_courses = [
        c for c in all_courses if str(c.get("id", "")) in teacher_course_ids
    ]
    roles: dict[str, Any] = {}
    for role, courses in [("student", student_courses), ("teacher", teacher_courses)]:
        try:
            if role == "student":
                roles[role] = collect_student(
                    client, courses, days, now, hidden_course_ids,
                )
            else:
                roles[role] = collect_teacher(
                    client, courses, days, now, hidden_course_ids,
                )
        except ClassroomPermissionError as error:
            roles[role] = {
                "available": False,
                "error": str(error),
                "courses": [],
                "hidden_courses": [],
            }
    return {
        "schema_version": PAYLOAD_VERSION,
        "fetched_at": now.isoformat(),
        "days": days,
        "roles": roles,
    }


def print_terminal(data: dict[str, Any]) -> None:
    print(f"Google Classroom — assignments due in the next {data['days']} days")
    for role, heading in (("student", "Student"), ("teacher", "Teaching")):
        role_data = data["roles"][role]
        print(f"\n{heading}")
        if role_data["error"]:
            print(f"  {role_data['error']}")
            continue
        if not role_data["courses"]:
            print("  No active courses found.")
            continue
        for course in role_data["courses"]:
            detail = course.get("section") or course["name"]
            print(f"\n{course['name']} ({detail})")
            for assignment in course["assignments"]:
                status = "published" if assignment["published"] else "draft"
                print(f"  [{status:9}] {assignment['due_at'][:10]}  {assignment['name']}")


def run_oauth_flow(client_id: str, client_secret: str) -> dict[str, str]:
    """Run a local OAuth2 authorization flow for Google Classroom."""
    port = 8099
    redirect_uri = f"http://localhost:{port}"
    scope = " ".join(GOOGLE_CLASSROOM_SCOPES)

    auth_params = urlencode({
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": scope,
        "access_type": "offline",
        "prompt": "consent",
    })
    auth_url = f"{GOOGLE_AUTH_URL}?{auth_params}"

    print(f"Opening browser for Google authorization...")
    print(f"If the browser does not open, visit:\n{auth_url}\n")
    webbrowser.open(auth_url)

    auth_code = None

    class AuthHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            nonlocal auth_code
            parsed = urlparse(self.path)
            params = parse_qs(parsed.query)
            if "code" in params:
                auth_code = params["code"][0]
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(b"<h1>Authorization successful!</h1><p>You can close this tab.</p>")
            else:
                error = params.get("error", ["unknown"])[0]
                self.send_response(400)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                self.wfile.write(f"<h1>Authorization failed: {error}</h1>".encode())

        def log_message(self, format, *args):
            pass

    server = http.server.HTTPServer(("localhost", port), AuthHandler)
    server.timeout = 120
    server.handle_request()

    if not auth_code:
        raise RuntimeError("Authorization failed or timed out")

    token_data = urlencode({
        "code": auth_code,
        "client_id": client_id,
        "client_secret": client_secret,
        "redirect_uri": redirect_uri,
        "grant_type": "authorization_code",
    }).encode("utf-8")
    request = Request(GOOGLE_TOKEN_URL, data=token_data, method="POST")
    request.add_header("Content-Type", "application/x-www-form-urlencoded")
    try:
        with build_opener().open(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            payload = json.loads(response.read(MAX_RESPONSE_BYTES).decode("utf-8"))
    except HTTPError as error:
        body = error.read(MAX_RESPONSE_BYTES).decode("utf-8", errors="replace")
        try:
            payload = json.loads(body)
            msg = payload.get("error_description", payload.get("error", str(error)))
        except (json.JSONDecodeError, ValueError):
            msg = str(error)
        raise RuntimeError(f"Token exchange failed: {msg}") from error

    if "refresh_token" not in payload:
        msg = payload.get("error_description", payload.get("error", "no refresh token"))
        raise RuntimeError(f"Token exchange failed: {msg}")

    return {
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": payload["refresh_token"],
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=["fetch", "set-token", "clear-token", "hide-course", "unhide-course",
                 "submit"],
    )
    parser.add_argument("course_id", nargs="?")
    parser.add_argument("--days", type=int, default=14)
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--course-name", default="")
    parser.add_argument("--course-section", default="")
    parser.add_argument("--client-id", default="")
    parser.add_argument("--client-secret", default="")
    parser.add_argument("--course-work-id", default="",
                        help="Assignment ID to submit")
    parser.add_argument("--link-url", default="",
                        help="Link URL to attach and submit")
    parser.add_argument("--title", default="",
                        help="Title for the attachment")
    args = parser.parse_args()
    try:
        if args.command == "set-token":
            client_id = args.client_id or input("Google OAuth2 Client ID: ").strip()
            client_secret = args.client_secret or input("Google OAuth2 Client Secret: ").strip()
            if not client_id or not client_secret:
                raise RuntimeError("Client ID and Client Secret are required")
            creds = run_oauth_flow(client_id, client_secret)
            save_credentials(creds["client_id"], creds["client_secret"], creds["refresh_token"])
            print("Google Classroom credentials saved in the system keyring.")
            return 0
        if args.command == "clear-token":
            clear_credentials()
            print("Google Classroom credentials removed from the system keyring.")
            return 0
        if args.command in {"hide-course", "unhide-course"}:
            if not args.course_id:
                raise RuntimeError("A course ID is required")
            hidden = args.command == "hide-course"
            set_course_hidden(args.course_id, hidden, args.course_name, args.course_section)
            print("Course hidden." if hidden else "Course unhidden.")
            return 0
        if args.command == "submit":
            if not args.course_id:
                raise RuntimeError("A course ID is required")
            if not args.course_work_id:
                raise RuntimeError("An assignment ID (--course-work-id) is required")
            creds = get_credentials()
            if not creds:
                raise RuntimeError(
                    "No Google Classroom credentials are saved. "
                    "Run 'omaclasroom set-token' to authorize."
                )
            access_token = refresh_access_token(
                creds["client_id"], creds["client_secret"], creds["refresh_token"],
            )
            client = ClassroomClient(access_token)
            result = client.submit_assignment(
                args.course_id, args.course_work_id,
                link_url=args.link_url, title=args.title,
            )
            state = result.get("state", "UNKNOWN")
            print(f"Assignment submitted! State: {state}")
            return 0
        creds = get_credentials()
        if not creds:
            raise RuntimeError(
                "No Google Classroom credentials are saved. "
                "Run 'omaclasroom set-token' to authorize."
            )
        access_token = refresh_access_token(
            creds["client_id"], creds["client_secret"], creds["refresh_token"],
        )
        hidden_ids = set(hidden_courses_for())
        data = collect(
            ClassroomClient(access_token),
            max(1, args.days),
            hidden_course_ids=hidden_ids,
        )
        if args.as_json:
            print(json.dumps(data, indent=2, ensure_ascii=False))
        else:
            print_terminal(data)
        return 0
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"omaclasroom: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
